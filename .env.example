# Copy to your environment. No real values — ever.
# Environment variables win over local.settings.json (which is git-ignored).

AI_PROVIDER=Fallback
# AI_PROVIDER=Meta  # Meta only, no fallback
# Leave AI_PROVIDER unset for the default Meta-only Fallback chain.

# Twilio (voice)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_NUMBER=
TWILIO_VOICE_PUBLIC_BASE_URL=
TWILIO_VOICE_HANDOFF_NUMBER=
TWILIO_VOICE_DISCLOSURE_MESSAGE=

# Meta Model API (tier 1)
META_BASE_URL=https://api.meta.ai/v1
META_API_KEY=
META_MODEL=muse-spark-1.3
META_REASONING_EFFORT=minimal

# Baseten Spark Open (tier 2)
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_API_KEY=
BASETEN_MODEL=meta-models/muse-spark-open-1026
BASETEN_REASONING_EFFORT=low

# Fireworks Spark Open (tier 3)
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/muse-spark-open

# Modal Spark Open (tier 4, author's own deployment; needs BOTH values)
MODAL_BASE_URL=
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=
MODAL_MODEL=meta-models/Muse-Spark-Open-816B-A42B
MODAL_REASONING_EFFORT=medium

# Cosmos DB
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=

# Tenant routing
TENANT_ROUTING_VERIFICATION_KEY=
TENANT_ROUTING_DEFAULT_TENANT_ID=
